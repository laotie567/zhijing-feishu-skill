# 智竞未来 · 飞书 BOT 凭证模板
# 复制本文件内容到 ~/.hermes/.env（install.sh 会自动处理）
#
# 凭证获取：
#   1. 访问 https://open.feishu.cn → 创建企业自建应用
#   2. 在"凭证与基础信息"页获取 App ID 和 App Secret
#   3. 在"权限管理"开启以下权限：
#      - im:message（收发消息，必需）
#      - im:message.group_at_msg（群@消息，必需）
#      - im:chat（群信息读取）
#      - contact:user.id:readonly（识别用户身份）
#      - base:app:read / base:table:read / base:record:read / base:record:update（多维表格，仅启用备选工具时需要）
#   4. 在"事件与回调"配置：订阅"接收消息 v2.0"事件，用 WebSocket 模式
#   5. 在"机器人"菜单启用机器人能力
#   6. 发布应用版本并等待管理员审批通过

FEISHU_APP_ID=cli_your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket

# 群策略：open=任何群都能@机器人；如需限制改 closed 并配 FEISHU_ALLOWED_USERS
FEISHU_GROUP_POLICY=open

# 用户策略：默认应设 false 并配 FEISHU_ALLOWED_USERS（手机号/邮箱/open_id，英文逗号分隔，仅这些成员可驱动机器人）；
# 仅在内网/受控环境才设 true——true = 同租户任意人都能驱动它，且表格写入会以你本人的飞书身份执行。
FEISHU_ALLOW_ALL_USERS=false
FEISHU_ALLOWED_USERS=13800000000,you@example.com

# 默认通知投递群（可选，填群 chat_id）
FEISHU_HOME_CHANNEL=
FEISHU_HOME_CHANNEL_NAME=
